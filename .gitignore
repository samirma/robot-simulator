# Secrets
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# macOS
.DS_Store

# Per-machine agent state. .claude/settings.json, if added, IS shared.
.claude/settings.local.json

# --- Simulators: everything here is produced by each engine's ./run.sh ---
#
# Per-engine venvs.
simulator/*/.venv/

# The upstream clones, fetched by each engine's `run.sh setup`. They carry their
# own .git, so committing them would embed a second repository rather than its
# contents.
simulator/molmospaces/upstream/
simulator/robocasa/upstream/

# MLSPACES_CACHE_DIR: downloaded versioned assets, ~14 GB.
# Restored with `./run.sh assets ithor`.
simulator/molmospaces/data/

# MLSPACES_ASSETS_DIR: the symlink tree MolmoSpaces generates and force-refreshes
# (MLSPACES_FORCE_INSTALL=True), ~1.6 GB, plus datagen episode output. Curated robot
# files live in shared/robots/<name>/ precisely so they are not in here.
simulator/molmospaces/assets/

# Meshes shared/robot_models.py converts for MuJoCo (COLLADA, and STLs over its face
# limit): derived from robots_specs/ at setup (`run.sh setup`), or on first spawn.
simulator/shared/robots/myagv_mycobot280/assets/
simulator/shared/robots/rosmaster_x3_plus/assets/

# RoboCasa / robosuite downloaded assets and macros.
simulator/robocasa/assets/
simulator/robocasa/data/

# Scratch run output (keep the committed evidence videos, drop scratch runs).
simulator/*/outputs/
simulator/*/runs/
# `kitchen.sh inspect` used to write here (`run_task.sh` now writes under
# `robot_console/runs/task/`): one directory per episode, holding the eval log,
# the preflight's JSON and the recorded actions. Evidence of a particular run against a
# particular revision, never a fixture -- re-run rather than trusting a stale one.
simulator/runs/
simulator/*/logs/

# Screenshots written by kitchen.sh; regenerate with `./kitchen.sh shot`.
simulator/shots/

# Profiling output from the upstream test suites.
simulator/**/mlspaces_tests/**/profiling_results.txt

*.log

# MuJoCo drops this wherever it is run from, including the repo root.
MUJOCO_LOG.TXT

# The plan and the target spec are working documents regenerated per run;
# specs.json describes the delivered state and IS tracked.
implementation_plan.json
target_specs.json

# Official robot meshes — restored with ./fetch_robot_assets.sh, verified against
# robots_specs/meshes.sha256 (~220 MB, fetched from each robot's pinned upstream).
robots_specs/**/*.stl
robots_specs/**/*.STL
robots_specs/**/*.dae
